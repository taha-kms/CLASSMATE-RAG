# Embedding model (Sentence-Transformers)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# LLM backend and model
LLM_BACKEND=llama_cpp
# LLAMA_GPU_LAYERS=0        # layers offloaded to the GPU; 0 is CPU only
# HF_TOKEN=                 # only needed for private or gated repos

# Hugging Face cache directories.
# TRANSFORMERS_CACHE is deliberately absent: transformers deprecated it in
# favour of HF_HOME, which is set to the same directory just below, and
# leaving it set makes every command print a FutureWarning.
HUGGINGFACE_HUB_CACHE=./models/hf_cache
SENTENCE_TRANSFORMERS_HOME=./models/hf_cache
HF_HOME=./models/hf_cache

# Hugging Face repo and filename to download into ./models/
LLM_REPO_ID=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF
LLM_FILENAME=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
LLM_MODEL_PATH=./models/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf

# ChromaDB persistence
# Relative paths resolve against the project root, not the directory you
# happen to run from, so the CLI finds the same corpus from anywhere.
CHROMA_PERSIST_DIRECTORY=./indexes/chroma
CHROMA_COLLECTION_NAME=classmate_rag
BM25_DIRECTORY=./indexes/bm25
EMB_CACHE_DIR=./indexes/emb_cache

# Retrieval / chunking defaults
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
K_VECTOR=8
K_BM25=8
USE_HYBRID=true

# Processing toggles
ENABLE_OCR=false
ENABLE_LANGUAGE_DETECTION=true

# Ingestion tuning
# INGEST_THREADS=4          # chunking threads; defaults to half your cores
# DEDUP_CHUNKS=false        # drop near-duplicate chunks at ingest time
# DEDUP_THRESHOLD=0.92      # Jaccard similarity that counts as a duplicate

# Retrieval ergonomics applied after fusion
# ENABLE_NEIGHBOR_EXPANSION=true
# NEIGHBOR_RADIUS=1         # neighbouring chunks pulled in either side of a hit
# DOC_DIVERSITY_CAP=3       # most chunks kept from any one document

# Language behavior: default auto-detect; options: en, it, auto
DEFAULT_LANGUAGE=auto

# Logging
LOG_LEVEL=INFO

# ChromaDB HTTP API endpoint.
# CHROMA_HOST_PORT is the port docker-compose publishes on the host, and
# CHROMA_BIND_HOST which interface it binds to. Keep the port in
# CHROMA_HTTP_URL in step with CHROMA_HOST_PORT, or the app will start
# and then fail to reach the database.
CHROMA_BIND_HOST=127.0.0.1
CHROMA_HOST_PORT=8000
CHROMA_HTTP_URL=http://localhost:8000

# Model profile: light | balanced | heavy | custom
# `rag profiles` shows which of these fit this machine. `custom` uses the
# per-route paths below.
MODEL_PROFILE=custom

# --- Hybrid subject router (math/code/translation/default) ---
# Off by default: enable to swap models per query subject.
ENABLE_ROUTING=false
# ROUTE_MATH_MODEL_PATH=./models/DeepSeek-R1-Distill-Qwen-7B-Q4_K_M.gguf
# ROUTE_CODE_MODEL_PATH=./models/Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
# ROUTE_TRANSLATION_MODEL_PATH=./models/salamandraTA-7B-instruct.Q4_K_M.gguf
# ROUTE_DEFAULT_MODEL_PATH=./models/Qwen3-8B-Q4_K_M.gguf
# ROUTE_N_CTX=4096
# ROUTE_N_GPU_LAYERS=0
# ROUTE_MAX_TOKENS=768
# ROUTE_TEMPERATURE=0.2
# ROUTE_TOP_P=0.95
# ROUTE_QUERY_MARGIN=0.10
# ROUTE_METADATA_THRESHOLD=0.60
# ROUTE_TRANSLATION_REQUIRES_INTENT=true

# --- Citation / answer post-processing ---
# STRICT_CITATIONS=false        # enforce [n] tokens after generation
# APPEND_SOURCES_BLOCK=false    # append a "Sources" list when strict citations are on
# TRANSLATE_ON_MISS=false       # translate the answer if it came back in the wrong language
