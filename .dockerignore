# Keep the build context small and deterministic. Everything the image needs
# is copied explicitly in the Dockerfile.
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.egg-info
build
dist

# Runtime data. Several GB of it, and all of it belongs in a volume.
models/*
!models/.gitkeep
indexes/*
!indexes/.gitkeep
data/*
!data/.gitkeep

# Local config and scratch
.env
artifacts
.coverage
coverage.xml
.pytest_cache
.ruff_cache
docs
tests
tools
